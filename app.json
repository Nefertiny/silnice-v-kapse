{
  "expo": {
    "name": "Silnice v kapse",
    "slug": "silnice-v-kapse",
    "scheme": "silnicevkapse",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B14",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cz.silnicevkapse.app"
    },
    "android": {
      "package": "cz.silnicevkapse.app",
      "adaptiveIcon": {
        "backgroundColor": "#070B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#38E1FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Appka fotí škody a doklady po nehodě.",
          "photosPermission": "Appka vybírá fotky nehody z galerie."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Appka uloží místo nehody."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
